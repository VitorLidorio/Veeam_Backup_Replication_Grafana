                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "🕒 Última Modificação"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "Erro/Falha": {
                          "color": "dark-red",
                          "index": 1
                        },
                        "Falha": {
