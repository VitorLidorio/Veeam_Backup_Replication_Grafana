      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Backup LogicalTec (Arquivos Banco)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dfkdh7adoe2gwe"
                      },
                      "spec": {
                        "dataset": "rodoeverton",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    nome AS \"📄 Arquivo\",\r\n\r\n    TO_CHAR(\r\n        data,\r\n        'DD/MM/YYYY HH24:MI:SS'\r\n    ) AS \"🕒 Última Modificação\",\r\n\r\n    CASE\r\n        WHEN tamanho IS NULL\r\n          OR TRIM(tamanho) = ''\r\n          OR TRIM(tamanho) = '0'\r\n        THEN '-'\r\n        ELSE tamanho\r\n    END AS \"💾 Tamanho\",\r\n\r\n    CASE\r\n        WHEN LOWER(status) = 'success' THEN 'Sucesso'\r\n        WHEN LOWER(status) = 'errofalha' THEN 'Erro/Falha'\r\n        WHEN LOWER(status) LIKE '%erro%'\r\n          OR LOWER(status) LIKE '%falha%' THEN 'Falha'\r\n        ELSE status\r\n    END AS \"🚦 Status\"\r\n\r\nFROM \"Imports\".monitoramento_arquivos\r\n\r\nORDER BY data DESC\r\nLIMIT 3;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
